{
	"name": "miku-miku-crawler",
	"version": "3.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"author": {
		"name": "renbkna",
		"url": "https://github.com/renbkna"
	},
	"overrides": {
		"nanoid": "3.3.17",
		"postcss": "8.5.23",
		"undici": "7.29.0"
	},
	"scripts": {
		"hooks:install": "lefthook install --force",
		"dev": "bun run --parallel 'dev:*'",
		"dev:server": "bun --watch server/server.ts",
		"dev:client": "bun --bun vite",
		"build": "bun --bun vite build",
		"check": "bun run typecheck && bun run lint && bun test && bun run build",
		"typecheck": "tsgo -b --pretty false",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome ci .",
		"fix": "biome check --write .",
		"fix:unsafe": "biome check --write --unsafe .",
		"preview": "bun --bun vite preview",
		"start": "bun server/server.ts",
		"test": "bun test",
		"clean": "rm -rf dist coverage node_modules/.tmp"
	},
	"dependencies": {
		"@elysia/cors": "2.0.0-beta.1",
		"@elysia/openapi": "2.0.0-beta.1",
		"@elysia/static": "2.0.0-beta.1",
		"cheerio": "^1.2.0",
		"elysia": "2.0.0-beta.2",
		"elysia-rate-limit": "5.1.0",
		"exact-mirror": "1.2.4",
		"fast-decode-uri-component": "1.0.1",
		"franc": "^6.2.0",
		"ipaddr.js": "^2.4.0",
		"lru-cache": "^11.5.2",
		"pdfjs-dist": "^6.2.108",
		"pino": "^10.3.1",
		"playwright": "1.61.1",
		"robots-parser": "^3.0.1",
		"tough-cookie": "6.0.2",
		"typebox": "1.3.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@elysia/eden": "2.0.0-beta.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@vitejs/plugin-react": "^6.0.3",
		"lefthook": "^2.1.10",
		"lucide-react": "^1.25.0",
		"pino-pretty": "^13.1.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwindcss": "^4.3.3",
		"vite": "^8.1.5"
	},
	"patchedDependencies": {
		"@elysia/static@2.0.0-beta.1": "patches/@elysia%2Fstatic@2.0.0-beta.1.patch",
		"@elysia/openapi@2.0.0-beta.1": "patches/@elysia%2Fopenapi@2.0.0-beta.1.patch",
		"elysia-rate-limit@5.1.0": "patches/elysia-rate-limit@5.1.0.patch"
	}
}
