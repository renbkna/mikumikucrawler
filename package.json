{
	"name": "miku-miku-crawler",
	"version": "3.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"author": {
		"name": "renbkna",
		"url": "https://github.com/renbkna"
	},
	"scripts": {
		"hooks:install": "lefthook install --force",
		"dev": "bun run --parallel 'dev:*'",
		"dev:server": "bun --watch server/server.ts",
		"dev:client": "bun --bun vite",
		"build": "bun --bun vite build",
		"check": "bun run typecheck && bun run lint && bun test && bun run build",
		"typecheck": "tsgo -b --pretty false",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome ci .",
		"fix": "biome check --write .",
		"fix:unsafe": "biome check --write --unsafe .",
		"preview": "bun --bun vite preview",
		"start": "bun server/server.ts",
		"test": "bun test",
		"clean": "rm -rf dist coverage node_modules/.tmp"
	},
	"dependencies": {
		"@elysia/cors": "2.0.0-rc.0",
		"@elysia/openapi": "2.0.0-rc.0",
		"@elysia/static": "2.0.0-rc.0",
		"cheerio": "^1.2.0",
		"elysia": "2.0.0-rc.0",
		"exact-mirror": "1.2.6",
		"franc": "^6.2.0",
		"ipaddr.js": "^2.5.0",
		"lru-cache": "^11.5.3",
		"pdfjs-dist": "^6.4.299",
		"pino": "^10.4.0",
		"playwright": "1.64.1",
		"robots-parser": "^3.0.1",
		"tough-cookie": "6.0.2",
		"typebox": "1.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@elysia/eden": "2.0.0-rc.0",
		"@scalar/types": "0.24.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@vitejs/plugin-react": "^6.1.2",
		"lefthook": "^2.2.2",
		"lucide-react": "^1.61.0",
		"openapi-types": "12.1.3",
		"pino-pretty": "^13.2.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.5"
	}
}
